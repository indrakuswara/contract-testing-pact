{
  "consumer": {
    "name": "ReaderWeb"
  },
  "interactions": [
    {
      "description": "a request for an unknown article",
      "providerStates": [
        {
          "name": "no article with slug does-not-exist exists"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/articles/does-not-exist"
      },
      "response": {
        "body": {
          "error": "Article not found"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.error": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 404
      }
    },
    {
      "description": "a request for the qad-kafani article",
      "providerStates": [
        {
          "name": "a published article with slug qad-kafani exists"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/articles/qad-kafani"
      },
      "response": {
        "body": {
          "description": "A classical shalawat attributed to Imam Abdullah bin 'Alawi al-Haddad.",
          "id": "ae085c4b-3839-4269-a1c0-fcc8aadd37d9",
          "publishedAt": "2026-10-04T00:00:00.000Z",
          "slug": "qad-kafani",
          "status": "PUBLISHED",
          "title": "Qad Kafani",
          "type": "SHALAWAT",
          "units": [
            {
              "arab": "قَدْ كَفَانِيْ عِلْمُ رَبِّيْ",
              "english": "The knowledge of my Lord has truly sufficed me",
              "id": "qad-kafani-1",
              "latin": "Qad kafani 'ilmu Rabbi",
              "translation": "Sungguh telah cukup bagiku pengetahuan Tuhanku"
            }
          ]
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.description": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.publishedAt": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.slug": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.title": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.units": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.units[*].arab": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.units[*].english": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.units[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.units[*].latin": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.units[*].translation": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.4"
    },
    "pactRust": {
      "ffi": "0.5.8",
      "models": "1.3.16"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
